# Incolla qui il token di BotFather e salva, poi avvia con start.bat
TELEGRAM_TOKEN=INCOLLA_QUI_IL_TOKEN
# ID Telegram autorizzati, separati da virgola. Es: ALLOWED_IDS=123456789
# Se vuoto: il bot risponde a /start mostrando il tuo chat ID, così lo puoi copiare qui.
ALLOWED_IDS=
# Modello vocale offline: tiny (veloce, meno preciso), base (consigliato), small (preciso, lento)
VOICE_MODEL=base
